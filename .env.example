# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# URL pública do site, sem barra no final.
# Usada em metadata (canonical, Open Graph), sitemap.xml, robots.txt e JSON-LD.
# Na Vercel, defina em Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://samuelsantos.dev

# Endpoint do formulário no Formspree (https://formspree.io → New Form).
# Variável de servidor: usada só pela Server Action, nunca exposta ao navegador.
# Sem ela, o formulário mostra um aviso e oferece o e-mail de contato.
FORMSPREE_ENDPOINT=https://formspree.io/f/SEU_ID
