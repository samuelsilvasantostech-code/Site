# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Na Vercel, defina estas variáveis em Project → Settings → Environment Variables.

# URL pública do site, sem barra no final.
# Usada em canonical, Open Graph, sitemap.xml, robots.txt e dados estruturados.
NEXT_PUBLIC_SITE_URL=https://site-samuel-rosy.vercel.app

# Endpoint do formulário de contato (Formspree: https://formspree.io → New Form).
# Variável de servidor: usada só pela Server Action, nunca exposta ao navegador.
# Sem ela, o formulário avisa que o envio não está ativo e mostra o e-mail de contato
# (o site nunca finge que a mensagem foi enviada).
FORMSPREE_ENDPOINT=https://formspree.io/f/SEU_ID

# Não são variáveis de ambiente:
# - E-mail, telefone, WhatsApp, LinkedIn e Instagram ficam em content/data.ts (objeto `links`).
#   Para ocultar o WhatsApp, deixe `whatsapp: ""`.
# - Vercel Analytics e Speed Insights são ativados no painel da Vercel; não precisam de ID.
